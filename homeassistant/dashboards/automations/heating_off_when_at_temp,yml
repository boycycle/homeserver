alias: Heating - Off When @ Temp
description: Turns off heating system when all TRV zones are idle or off
triggers:
  - trigger: state
    entity_id:
      - climate.main_bedroom_bt
      - climate.living_room_bt
      - climate.bt_office
      - climate.bt_kitchen
      - climate.guest_bedroom_bt
      - climate.main_bathroom_2
      - climate.bedroom_3_bt
      - climate.hall_bt
      - climate.upstairs
      - climate.hot_water_tank
    attribute: hvac_action
    to:
      - idle
      - 'off'
    for:
      minutes: 1
conditions:
  - condition: template
    value_template: |-
      {{ expand([
        'climate.main_bedroom_bt',
        'climate.living_room_bt',
        'climate.bt_office',
        'climate.bt_kitchen',
        'climate.guest_bedroom_bt',
        'climate.main_bathroom_2',
        'climate.bedroom_3_bt',
        'climate.hall_bt',
        'climate.upstairs',
        'climate.hot_water_tank'
      ])
      | selectattr('attributes.hvac_action', 'eq', 'heating')
      | list
      | count == 0 }}
actions:
  - target:
      entity_id: switch.shellywalldisplay_heating
    action: switch.turn_off
mode: single
